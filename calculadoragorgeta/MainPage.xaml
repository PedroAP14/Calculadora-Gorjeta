<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="calculadoragorgeta.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="Subtotal:" />

            <Entry
                x:Name="NomeEntry"
                Placeholder="Digite aqui o nome do usúario" />

            <Label
                Text="Gorjeta" />

            <Label
                Text="15%" />

            <Button
                x:Name="Botao15Porcento"
                Text="15%" 
                SemanticProperties.Hint="Counts the number of times you click"
                HorizontalOptions="Fill" />

            <Button
                x:Name="Botao20Porcento"
                Text="20%" 
                SemanticProperties.Hint="Counts the number of times you click"
                HorizontalOptions="Fill" />

            <Label
                Text="Total:" />

            <Label
                Text="R$00,00"/>

            <Button
                x:Name="BotaoArrendodarParaCima"
                Text="Arrendondar para Cima" 
                SemanticProperties.Hint="Counts the number of times you click"
                HorizontalOptions="Fill" />

            <Button
                x:Name="BotaoArrendodarParaBaixo"
                Text="Arrendondar para Baixo" 
                SemanticProperties.Hint="Counts the number of times you click"                
                HorizontalOptions="Fill" />
            
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
